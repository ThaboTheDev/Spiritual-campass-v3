# Copy into your secret manager/local shell. Never commit populated credentials.
APP_ENV=development
PORT=8080
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_JWT_SECRET=server-only-project-jwt-secret-at-least-32-chars
PWA_ORIGIN=http://localhost:5000
API_BASE_URL=http://localhost:8080
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=sandbox-merchant-key
PAYFAST_PASSPHRASE=sandbox-passphrase
PAYFAST_SANDBOX=true
# Optional comma-separated CIDR overrides; defaults are official PayFast/GCP ranges.
# PAYFAST_ALLOWED_CIDRS=...
# TRUSTED_PROXY_CIDRS=35.191.0.0/16,130.211.0.0/22
MAX_BODY_BYTES=65536
